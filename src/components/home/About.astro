---
import CodeWindow from '../ui/CodeWindow.astro';
import StatTile from '../ui/StatTile.astro';
import type { Lang } from '../../config/site';
import { FACTS, PROFILE_CODE } from '../../data/profile';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
  kicker: string;
}
const { lang, kicker } = Astro.props;
const t = ui[lang].about;
---

<section id="about" class="wrap section" aria-labelledby="about-title" data-section>
  <!-- Bento: statement + stat tiles on the left, editor window + "now" on the right. -->
  <div class="grid gap-4 lg:grid-cols-12" data-stagger>
    <div class="card flex flex-col justify-between gap-10 p-8 lg:col-span-7" data-spotlight>
      <p class="kicker">{kicker}</p>
      <div>
        <h2 id="about-title" class="title">{t.title}</h2>
        <p class="mt-4 max-w-xl text-lg text-muted">{t.body}</p>
      </div>
    </div>

    <CodeWindow filename="nicolas.ts" lines={PROFILE_CODE} class="lg:col-span-5" />

    <div class="grid gap-4 sm:grid-cols-3 lg:col-span-8" data-stagger>
      {FACTS.map((fact) => <StatTile value={fact.value} percent={fact.percent} label={fact.label[lang]} />)}
    </div>

    <div class="card flex flex-col justify-between gap-6 lg:col-span-4">
      <p class="label flex items-center gap-2.5">
        <span class="pulse-dot"></span>
        {t.now}
      </p>
      <p class="text-lg font-medium">{t.nowText}</p>
    </div>
  </div>
</section>
