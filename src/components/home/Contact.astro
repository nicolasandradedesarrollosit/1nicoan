---
import CvButton from '../ui/CvButton.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { SITE, type Lang } from '../../config/site';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
  kicker: string;
}
const { lang, kicker } = Astro.props;
const t = ui[lang].contact;
---

<section id="contact" class="wrap section" aria-labelledby="contact-title" data-section data-reveal>
  <div class="card overflow-hidden px-6 py-14 sm:px-12 sm:py-20" data-spotlight>
    <div class="dots" aria-hidden="true"></div>
    <div class="dots dots--spot" aria-hidden="true"></div>

    <div class="relative">
      <p class="kicker">{kicker}</p>
      <h2 id="contact-title" class="mt-4 text-display leading-none font-semibold tracking-tighter">{t.title}</h2>
      <p class="mt-5 text-lg text-muted">{t.lead}</p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-2 inline-block text-lg break-all text-fg underline decoration-line underline-offset-4 hover:text-accent hover:decoration-accent sm:text-2xl"
      >
        {SITE.email}
      </a>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <button type="button" class="btn" data-copy={SITE.email} data-copied-label={t.copied} data-magnetic>
          <Icon name="copy" />
          <span data-copy-label aria-live="polite">{t.copy}</span>
        </button>
        <CvButton lang={lang} ghost />
        <SocialLinks />
      </div>
    </div>
  </div>
</section>
