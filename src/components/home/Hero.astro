---
import CvButton from '../ui/CvButton.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { SITE, type Lang } from '../../config/site';
import { ui } from '../../i18n/ui';
import { sectionPath } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].hero;

let letterIndex = 0;
const words = SITE.name.split(' ').map((word) => [...word].map((char) => ({ char, i: letterIndex++ })));
---

<section class="relative overflow-hidden" data-spotlight>
  <div class="dots" aria-hidden="true"></div>
  <div class="dots dots--spot" aria-hidden="true"></div>

  <div class="wrap relative pt-24 pb-16 sm:pt-36 sm:pb-24">
    <h1 class="text-display leading-[0.95] font-semibold tracking-tighter" aria-label={SITE.name}>
      {
        words.map((letters) => (
          <>
            <span class="split__word" aria-hidden="true">
              {letters.map(({ char, i }) => (
                <span class="split__letter" style={`--i:${i}`}>
                  {char}
                </span>
              ))}
            </span>{' '}
          </>
        ))
      }
    </h1>

    <p class="fade-up mt-7 max-w-xl text-lg text-muted sm:text-xl" style="--d:450ms">{t.tagline}</p>

    <div class="fade-up mt-9 flex flex-wrap items-center gap-3" style="--d:600ms">
      <CvButton lang={lang} />
      <a class="btn btn--ghost" href={sectionPath(lang, 'projects')} data-magnetic>
        {t.viewProjects}
        <Icon name="arrow-right" />
      </a>
      <SocialLinks />
    </div>

    <p class="fade-up label mt-20 hidden items-center gap-3 text-[0.625rem] sm:flex" style="--d:900ms" aria-hidden="true">
      <span class="scroll-hint"></span>
      {t.scroll}
    </p>
  </div>
</section>
