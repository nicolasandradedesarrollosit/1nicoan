---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Lang } from '../../config/site';
import { SKILLS } from '../../data/skills';
import { ui } from '../../i18n/ui';

/** Home section: one ruled row per skill group of data/skills.ts, like a spec sheet. */
interface Props {
  lang: Lang;
  kicker: string;
}
const { lang, kicker } = Astro.props;

// Full class names so Tailwind can see them.
const TINT = { front: 'bg-front', back: 'bg-back', tools: 'bg-tools' };
---

<section id="stack" class="wrap section" aria-labelledby="stack-title" data-section>
  <SectionHeading id="stack" kicker={kicker} title={ui[lang].stack.title} />

  <dl class="border-b border-line" data-stagger>
    {
      SKILLS.map((group) => (
        <div class="grid gap-x-8 gap-y-4 border-t border-line py-7 md:grid-cols-12 md:py-9">
          <dt class="md:col-span-4">
            <span class="flex items-center gap-2.5 text-lg font-semibold">
              <span class:list={['size-2 rounded-[2px]', TINT[group.id]]} aria-hidden="true" />
              {group.name}
            </span>
            <span class="mt-1 block text-sm text-muted">{group.description[lang]}</span>
          </dt>
          <dd class="md:col-span-8">
            <ul role="list" class="flex flex-wrap gap-x-3 gap-y-1 text-lg font-medium sm:text-xl">
              {group.items.map((item) => (
                <li class="after:ml-3 after:font-normal after:text-muted/40 after:content-['/'] last:after:hidden">
                  {item}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
