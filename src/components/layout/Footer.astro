---
import Icon from '../ui/Icon.astro';
import { SITE, type Lang } from '../../config/site';
import { ui } from '../../i18n/ui';
import { localizedPath } from '../../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="section overflow-hidden border-t border-line">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6 text-xs text-muted">
    <p class="font-mono">© {year} {SITE.name}</p>
    <ul role="list" class="flex gap-5">
      <li><a class="no-underline hover:text-fg" href={localizedPath(lang, 'experience')}>{t.experience.pageTitle}</a></li>
      <li><a class="no-underline hover:text-fg" href={localizedPath(lang, 'projects')}>{t.projects.pageTitle}</a></li>
    </ul>
    <a href="#main" class="inline-flex items-center gap-1 no-underline hover:text-fg">
      {t.footer.top}
      <Icon name="arrow-up" />
    </a>
  </div>
  <p
    class="wrap pt-6 pb-12 text-[clamp(2.5rem,11.5vw,9rem)] leading-[1.1] sm:pb-16 font-semibold tracking-tighter whitespace-nowrap text-surface select-none"
    aria-hidden="true"
  >
    {SITE.name}
  </p>
</footer>
