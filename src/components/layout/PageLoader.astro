<!--
  Full-screen curtain shown while the theme or the language changes: the monogram
  draws itself, the change happens behind it, then it fades out. Driven by
  `data-loading` on <html> (see src/lib/loader.ts).
-->
<div class="loader" aria-hidden="true">
  <Monogram class="w-20" />
</div>
