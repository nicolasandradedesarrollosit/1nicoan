---
import Icon from './Icon.astro';
import { SITE, type Lang } from '../../config/site';
import { ui } from '../../i18n/ui';

interface Props {
  lang: Lang;
  ghost?: boolean;
}
const { lang, ghost = false } = Astro.props;
---

<a class:list={['btn', ghost && 'btn--ghost']} href={SITE.cv[lang]} download data-astro-reload data-magnetic>
  <Icon name="download" />
  {ui[lang].hero.downloadCv}
</a>
