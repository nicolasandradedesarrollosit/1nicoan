---
/** Endless strip of words. The list is rendered twice so the loop has no seam. */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<div class="marquee border-y border-line py-4" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <ul role="list" class="flex shrink-0 items-center gap-10 pr-10">
          {items.map((item) => (
            <li class="flex items-center gap-10 font-mono text-sm whitespace-nowrap text-muted">
              {item}
              <span class="size-1 rounded-full bg-line" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
