---
/** The "NA" mark as two strokes (same paths as public/favicon.svg). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 40 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path pathLength="1" d="M4 20V4l12 16V4"></path>
  <path pathLength="1" d="M22 20l7-16 7 16M24.6 14h8.8"></path>
</svg>
