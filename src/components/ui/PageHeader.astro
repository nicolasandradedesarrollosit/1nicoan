---
import Icon from './Icon.astro';

interface Props {
  back: { href: string; label: string };
  kicker: string;
  title: string;
  lead?: string;
  titleTransition?: string;
}
const { back, kicker, title, lead, titleTransition } = Astro.props;
---

<header class="relative overflow-hidden" data-spotlight>
  <div class="dots" aria-hidden="true"></div>
  <div class="dots dots--spot" aria-hidden="true"></div>

  <div class="wrap relative pt-14 pb-12 sm:pt-20">
    <a class="link fade-up text-muted" href={back.href}>
      <Icon name="arrow-left" />
      {back.label}
    </a>
    <p class="kicker fade-up mt-10" style="--d:80ms">{kicker}</p>
    <h1
      class="fade-up mt-4 text-display leading-none font-semibold tracking-tighter"
      style="--d:140ms"
      transition:name={titleTransition}
    >
      {title}
    </h1>
    {lead && <p class="fade-up mt-6 max-w-xl text-lg text-muted sm:text-xl" style="--d:220ms">{lead}</p>}
    <slot />
  </div>
</header>
